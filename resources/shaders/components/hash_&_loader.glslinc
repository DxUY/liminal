// --- Hashing & Randomization Utilities ---

uint murmurHash13(uvec3 src) {
	const uint M = 0x5bd1e995u;
	uint h = 1190494759u;
	src *= M; src ^= src >> 24u; src *= M;
	h *= M; h ^= src.x; h *= M; h ^= src.y; h *= M; h ^= src.z;
	h ^= h >> 13u; h *= M; h ^= h >> 15u;
	return h;
}

float hash13(vec3 src) {
	uint h = murmurHash13(floatBitsToUint(src));
	return uintBitsToFloat(h & 0x007fffffu | 0x3f800000u) - 1.0;
}

uint loadCellData(ivec2 id, ivec2 size) {
	if (id.y >= size.y || id.y < 0 || id.x < 0 || id.x >= size.x) {
		return 0u;
	}
    
	vec4 pixel = imageLoad(terrain, id);
	uint r = uint(pixel.r * 255.0);
	uint g = uint(pixel.g * 255.0);
	return (g << 8) | r;
}
