uint murmurHash13(uvec3 src) {
	const uint M = 0x5bd1e995u;
	uint h = 1190494759u;
	src *= M; src ^= src >> 24u; src *= M;
	h *= M; h ^= src.x; h *= M; h ^= src.y; h *= M; h ^= src.z;
	h ^= h >> 13u; h *= M; h ^= h >> 15u;
	return h;
}

float hash13(vec3 src) {
	uint h = murmurHash13(floatBitsToUint(src));
	return uintBitsToFloat(h & 0x007fffffu | 0x3f800000u) - 1.0;
}

bool isOutOfBounds(ivec2 id, ivec2 size) {
	return id.x < 0 || id.x >= size.x || id.y < 0 || id.y >= size.y;
}

vec4 loadCellData(ivec2 id) {
	return imageLoad(terrain, id);
}

float loadVelocity(ivec2 id) {	
	return imageLoad(velocity, id).r * 128.0; 
}

void storeVelocity(ivec2 id, float vel) {
	float normalized_vel = clamp(vel / 128.0, -1.0, 1.0);
	imageStore(velocity, id, vec4(normalized_vel, 0.0, 0.0, 1.0));
}
