// --- Conflict Resolution & Winner Evaluation ---

ivec2 getCachedOrComputedMove(ivec2 localPos, ivec2 globalPos) {
	if (localPos.x >= 0 && localPos.x < 8 && localPos.y >= 0 && localPos.y < 8) {
		return s_move[localPos.y * 8 + localPos.x];
	}
	return calculateDesiredMove(localPos, globalPos);
}

int getWinnerType(ivec2 localTarget, ivec2 globalTarget) {
	// 1. Vertical Movement (Straight Gravity / Buoyancy - Highest Priority)
	ivec2 srcStraight = localTarget + ivec2(0, -1);
	if (getSharedElement(srcStraight) > 0) {
		ivec2 move = getCachedOrComputedMove(srcStraight, globalTarget + ivec2(0, -1));
		if (move.x == 0 && move.y != 0) return WINNER_STRAIGHT;
	}

	// Dynamic parity toggle for fair left/right resolution
	bool checkLeftFirst = ((globalTarget.x + globalTarget.y + params.offset) & 1) == 0;
	int dirA = checkLeftFirst ? 1 : -1;
	int dirB = -dirA;

	// 2. Diagonal Movement (Powders, Sand, Rising Smoke - Medium Priority)
	ivec2 srcDiagA = localTarget + ivec2(dirA, -1);
	if (getSharedElement(srcDiagA) > 0) {
		ivec2 move = getCachedOrComputedMove(srcDiagA, globalTarget + ivec2(dirA, -1));
		if (move == ivec2(-dirA, 1)) return WINNER_DIAG;
	}

	ivec2 srcDiagB = localTarget + ivec2(dirB, -1);
	if (getSharedElement(srcDiagB) > 0) {
		ivec2 move = getCachedOrComputedMove(srcDiagB, globalTarget + ivec2(dirB, -1));
		if (move == ivec2(-dirB, 1)) return WINNER_DIAG;
	}

	// 3. Horizontal Dispersion (Liquids, Gases - Lowest Priority)
	ivec2 srcHorizA = localTarget + ivec2(dirA, 0);
	if (getSharedElement(srcHorizA) > 0) {
		ivec2 move = getCachedOrComputedMove(srcHorizA, globalTarget + ivec2(dirA, 0));
		if (move == ivec2(-dirA, 0)) return WINNER_HORIZ;
	}

	ivec2 srcHorizB = localTarget + ivec2(dirB, 0);
	if (getSharedElement(srcHorizB) > 0) {
		ivec2 move = getCachedOrComputedMove(srcHorizB, globalTarget + ivec2(dirB, 0));
		if (move == ivec2(-dirB, 0)) return WINNER_HORIZ;
	}

	return WINNER_NONE;
}
