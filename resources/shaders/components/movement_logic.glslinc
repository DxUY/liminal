// --- Helper Movement Checks ---

ivec2 calculateDiagonalMove(ivec2 localPos, ivec2 globalPos, ElementProperties current) {
	ivec2 gravVec = ivec2(0, current.gravity_dir);
	ivec2 leftDiag = gravVec + ivec2(-1, 0);
	ivec2 rightDiag = gravVec + ivec2(1, 0);

	int targetLeft = getSharedElement(localPos + leftDiag);
	int targetRight = getSharedElement(localPos + rightDiag);

	bool canLeft = (targetLeft == 0) || (targetLeft > 0 && current.density > element_db.props[targetLeft - 1].density);
	bool canRight = (targetRight == 0) || (targetRight > 0 && current.density > element_db.props[targetRight - 1].density);

	if (canLeft && canRight) {
		float rng = hash13(vec3(globalPos, params.time));
		bool goLeft = rng > 0.5;
		if (((globalPos.x + globalPos.y + params.offset) & 1) != 0) goLeft = !goLeft;
		return goLeft ? leftDiag : rightDiag;
	} else if (canLeft) {
		return leftDiag;
	} else if (canRight) {
		return rightDiag;
	}

	return ivec2(0, 0);
}

ivec2 calculateHorizontalSpread(ivec2 localPos, ivec2 globalPos, ElementProperties current) {
	if (current.dispersion_rate <= 0) return ivec2(0, 0);

	int leftDist = 0;
	int rightDist = 0;

	// Check Left Spread
	for (int i = 1; i <= current.dispersion_rate; i++) {
		ivec2 sidePos = localPos + ivec2(-i, 0);
		int sideId = getSharedElement(sidePos);
		if (sideId == 0) { leftDist = i; } 
		else break;
	}

	// Check Right Spread
	for (int i = 1; i <= current.dispersion_rate; i++) {
		ivec2 sidePos = localPos + ivec2(i, 0);
		int sideId = getSharedElement(sidePos);
		if (sideId == 0) { rightDist = i; } 
		else break;
	}

	if (leftDist == 0 && rightDist == 0) return ivec2(0, 0);

	bool goLeft = false;
	if (leftDist > 0 && rightDist > 0) {
		float rng = hash13(vec3(globalPos, params.time));
		goLeft = rng > 0.5;
		if (((globalPos.x + globalPos.y + params.offset) & 1) != 0) goLeft = !goLeft;
	} else {
		goLeft = (leftDist > 0);
	}

	return goLeft ? ivec2(-1, 0) : ivec2(1, 0);
}

// --- Main Element Movement Evaluator ---

ivec2 calculateDesiredMove(ivec2 localPos, ivec2 globalPos) {
	int id = getSharedElement(localPos);
	if (id <= 0) return ivec2(0, 0);

	// Single SSBO lookup for any element
	ElementProperties current = element_db.props[id - 1];
	ivec2 currentVel = ivec2(current.vel_x, current.vel_y);

	// 1. Explicit Velocity Impulse Check
	if (currentVel != ivec2(0, 0)) {
		ivec2 velMove = clamp(currentVel, ivec2(-1, -1), ivec2(1, 1));
		int targetId = getSharedElement(localPos + velMove);
		if (targetId == 0 || (targetId > 0 && current.density > element_db.props[targetId - 1].density)) {
			return velMove;
		}
	}

	// 2. Default Vertical Step (Gravity or Buoyancy)
	ivec2 gravVec = ivec2(0, current.gravity_dir);
	int targetId = getSharedElement(localPos + gravVec);
	if (targetId != -1) {
		int targetDensity = (targetId > 0) ? element_db.props[targetId - 1].density : 0;
		if (targetId == 0 || current.density > targetDensity) {
			return gravVec;
		}
	}

	// 3. Diagonal Slide Check (Powders, Sand, Rising Smoke)
	ivec2 diagMove = calculateDiagonalMove(localPos, globalPos, current);
	if (diagMove != ivec2(0, 0)) return diagMove;

	// 4. Horizontal Spread Check (Liquids, Gases)
	if (current.dispersion_rate > 0) {
		return calculateHorizontalSpread(localPos, globalPos, current);
	}

	return ivec2(0, 0);
}
