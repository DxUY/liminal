// --- Element-Specific / Type-Specific Behaviors ---

bool isSolidDisturbed(ivec2 localPos, int currentId, int currentSubIndex, int currentState) {
	if (currentState != 0) return true;

	int idAbove = getSharedElement(localPos + ivec2(0, -1));
	int stateAbove = getSharedState(localPos + ivec2(0, -1));

	if (idAbove > 0) {
		int resistance = solids_db.data[currentSubIndex * PROP_STRIDE + 2];
		int collapseThreshold = solids_db.data[currentSubIndex * PROP_STRIDE + 5];
		if (stateAbove == 1 || resistance <= collapseThreshold) return true;
	}
	return false;
}

ivec2 getSolidExtraMove(ivec2 localPos, ivec2 globalPos, int currentDensity) {
	int idLeft = getSharedElement(localPos + ivec2(-1, 0));
	int idRight = getSharedElement(localPos + ivec2(1, 0));
	int idBelowLeft = getSharedElement(localPos + ivec2(-1, 1));
	int idBelowRight = getSharedElement(localPos + ivec2(1, 1));

	bool canPassLeft = (idLeft == 0) || (currentDensity > getElementDensity(idLeft));
	bool canPassRight = (idRight == 0) || (currentDensity > getElementDensity(idRight));

	bool canDiagLeft = canPassLeft && ((idBelowLeft == 0) || (currentDensity > getElementDensity(idBelowLeft)));
	bool canDiagRight = canPassRight && ((idBelowRight == 0) || (currentDensity > getElementDensity(idBelowRight)));

	if (canDiagLeft && canDiagRight) {
		float rng = hash13(vec3(globalPos, params.time));
		bool left = rng > 0.5;
		if (((globalPos.x + globalPos.y + params.offset) & 1) != 0) left = !left;

		return left ? MOVE_DIAG_LEFT : MOVE_DIAG_RIGHT;
	} else if (canDiagLeft) {
		return MOVE_DIAG_LEFT;
	} else if (canDiagRight) {
		return MOVE_DIAG_RIGHT;
	}

	return MOVE_NONE;
}

int getSpreadDistance(ivec2 localPos, int currentDensity, int dir, int maxDist, bool isGas) {
	int validDist = 0;
	for (int i = 1; i <= maxDist; i++) {
		ivec2 sidePos = localPos + ivec2(i * dir, 0);
		ivec2 checkPos = localPos + ivec2(i * dir, isGas ? -1 : 1);
		
		if (sidePos.x < -2 || sidePos.x > 9 || sidePos.y < -2 || sidePos.y > 9 ||
		    checkPos.x < -2 || checkPos.x > 9 || checkPos.y < -2 || checkPos.y > 9) {
			break;
		}

		int sideId = getSharedElement(sidePos);
		int verticalCheckId = getSharedElement(checkPos);
		
		// Fix: Allow passing through empty space OR same/lower density elements
		bool canPassThroughSide = (sideId == 0 || (sideId > 0 && currentDensity >= getElementDensity(sideId)));
		bool canFlowVertically = (verticalCheckId == 0 || (verticalCheckId > 0 && currentDensity > getElementDensity(verticalCheckId)));

		if (canPassThroughSide) {
			if (sideId == 0 || currentDensity > getElementDensity(sideId)) {
				validDist = i;
			}
			if (canFlowVertically) {
				break;
			}
		} else {
			break;
		}
	}
	return validDist;
}

ivec2 getLiquidExtraMove(ivec2 localPos, ivec2 globalPos, int currentDensity) {
	int currentId = getSharedElement(localPos);
	if (currentId <= 0) return MOVE_NONE;

	int subIndex = elements_db.data[(currentId - 1) * 2 + 1];
	int dispersionRate = liquid_db.data[subIndex * PROP_STRIDE + 2];

	if (dispersionRate <= 0) return MOVE_NONE;

	int leftDist = getSpreadDistance(localPos, currentDensity, -1, dispersionRate, false);
	int rightDist = getSpreadDistance(localPos, currentDensity, 1, dispersionRate, false);

	if (leftDist == 0 && rightDist == 0) return MOVE_NONE;

	bool goLeft = false;
	if (leftDist > 0 && rightDist > 0) {
		float rng = hash13(vec3(globalPos, params.time));
		goLeft = rng > 0.5;
		if (((globalPos.x + globalPos.y + params.offset) & 1) != 0) goLeft = !goLeft;
	} else {
		goLeft = (leftDist > 0);
	}

	return goLeft ? ivec2(-1, 0) : ivec2(1, 0);
}
