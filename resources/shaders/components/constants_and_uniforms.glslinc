// --- Image Bindings ---
layout(rg8, set = 0, binding = 0) uniform readonly image2D terrain_read;
layout(rg8, set = 0, binding = 1) uniform writeonly image2D terrain_write;

// --- Unified Element Struct & Property Buffer ---
// Layout MUST match the 9 integers serialized by Element.serialize_gpu()
struct ElementProperties {
	int type;
	int density;
	int gravity_dir;
	int vel_x;                  // Vector2i velocity X component
	int vel_y;                  // Vector2i velocity Y component
	int dispersion_rate;
	int friction;
	int viscosity;
	int energy_conservation;
};

// Replaces elements_db, solids_db, and liquid_db with a single SSBO
layout(set = 0, binding = 2, std430) buffer ElementDB {
	ElementProperties props[];
} element_db;

// --- Push Constants ---
layout(push_constant, std430) uniform Params {
	int offset;
	float time;
	ivec2 mousePos;
} params;

// --- Conflict Resolution Winners (Simplified) ---
// Movement vectors are removed; movement is determined directly by vel_x and vel_y.
// DIAG_LEFT & DIAG_RIGHT are merged into WINNER_DIAG.
const int WINNER_NONE = 0;
const int WINNER_STRAIGHT = 1;
const int WINNER_DIAG = 2;
const int WINNER_HORIZ = 3;

// --- Shared Memory Caches ---
// Workgroup size is 8x8, plus a 2-pixel border for neighbor lookups = 12x12
shared int s_cache[144];
shared int s_state_cache[144];
shared ivec2 s_move[64];

// --- Cache Access Macros ---
#define CACHE(x, y) s_cache[(y) * 12 + (x)]
#define STATE_CACHE(x, y) s_state_cache[(y) * 12 + (x)]
